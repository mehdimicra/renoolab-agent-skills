{
  "name": "renoolab-agent-skills",
  "version": "0.5.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Source, génération et validation des Agent Skills RenooLab.",
  "scripts": {
    "generate": "node scripts/generate-skills.mjs",
    "validate": "node scripts/validate-catalog.mjs",
    "validate:skills-ref": "node scripts/validate-skills-ref.mjs",
    "validate:gemini": "npx --yes @google/gemini-cli@0.54.0 extensions validate .",
    "eval:dry": "node scripts/run-behavioral-evals.mjs --dry-run --host claude --suite all",
    "eval:claude": "node scripts/run-behavioral-evals.mjs --host claude --suite all --runs 1 --concurrency 3",
    "eval:codex": "node scripts/run-behavioral-evals.mjs --host codex --suite all --runs 1 --concurrency 2",
    "discovery:build": "node scripts/build-discovery-artifacts.mjs",
    "discovery:test": "node scripts/test-discovery-artifacts.mjs",
    "perplexity:build": "node scripts/build-perplexity-skill.mjs --output dist/perplexity/renoolab-trouver-choisir-artisans.zip",
    "perplexity:test": "node scripts/test-perplexity-skill.mjs",
    "test": "npm run generate && npm run validate && npm run eval:dry && npm run discovery:test && npm run perplexity:test"
  },
  "engines": {
    "node": ">=20"
  }
}
